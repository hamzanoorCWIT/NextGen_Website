# Brevo transactional email (server-only — never use NEXT_PUBLIC_*)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=NextGen Contact Centre

# REQUIRED — admin inbox for contact submissions
# Missing/empty returns: { "error": "Recipient email is not configured" }
TO_EMAIL=

# Optional brand / security
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# TRUST_PROXY=true
# CONTACT_ORIGIN_ALLOWLIST=http://localhost:3000,https://your-domain.com
